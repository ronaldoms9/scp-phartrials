# Copie para .env e preencha: cp .env.example .env
# O .env NAO deve ser commitado (esta no .gitignore).

# Banco principal (usuario da aplicacao)
# Em producao/Docker "localhost" usa socket unix.
DB_HOST=localhost
DB_NAME=pt_monitoria
DB_USER=pt
DB_PASS=troque_esta_senha

# Usuario root: bancos auxiliares (meddra), relatorios rep_*.php e modulo pesquisa
DB_ROOT_USER=root
DB_ROOT_PASS=troque_esta_senha_root

# Banco do mensageiro (usa DB_HOST/DB_USER/DB_PASS)
MSG_DB_NAME=mensageiro

# Host do banco remoto (so usado quando $teste = 1 nas classes de conexao)
DB_REMOTE_HOST=
